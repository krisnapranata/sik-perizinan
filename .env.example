# Salin menjadi .env lalu sesuaikan
# Buat nilai acak: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
DJANGO_DEBUG=0
# Pisahkan dengan koma: domain dan/atau IP server. Biarkan 127.0.0.1 untuk healthcheck.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,perizinan.example.go.id
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,https://perizinan.example.go.id

# Alamat dasar tautan di email
SITUS_URL=https://perizinan.example.go.id

# MariaDB di localhost server. Ganti password sebelum go-live;
# scripts/setup-mariadb.sh membaca nilai dari berkas ini.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sik
DB_USER=sik
DB_PASSWORD=sik

# SMTP untuk verifikasi akun dan notifikasi status.
# Selama EMAIL_HOST kosong, email TIDAK terkirim (hanya tercetak di log).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_FROM=SIK Perizinan <noreply@example.go.id>

# Password awal untuk pengguna hasil impor CSV/Excel yang kolom password-nya kosong.
# Bisa diubah juga di halaman impor sebelum mengunggah.
IMPOR_PASSWORD_DEFAULT=Sik-Lotim-2026!
