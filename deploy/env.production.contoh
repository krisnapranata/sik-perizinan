# Salin menjadi .env.production (folder induk) lalu isi. JANGAN commit .env.production.
# Buat nilai acak: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
DJANGO_DEBUG=0
# Domain di Nginx Proxy Manager. 127.0.0.1 dan localhost wajib tetap ada untuk healthcheck.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,perizinan.example.go.id
DJANGO_CSRF_TRUSTED_ORIGINS=https://perizinan.example.go.id

# Alamat dasar tautan di email dan QR dokumen izin
SITUS_URL=https://perizinan.example.go.id

# MariaDB container sik_db (service "db"). Nilai sama dengan .env.db.
DB_HOST=db
DB_PORT=3306
DB_NAME=sik
DB_USER=sik
DB_PASSWORD=ganti-sandi-db

# SMTP untuk OTP pendaftaran dan notifikasi status.
# Selama EMAIL_HOST kosong, email TIDAK terkirim (hanya tercetak di log).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_FROM=SIK Perizinan <noreply@example.go.id>

# Password awal untuk pengguna hasil impor CSV/Excel yang kolom password-nya kosong.
IMPOR_PASSWORD_DEFAULT=ganti-password-awal-impor

# Dokumen izin (opsional; bawaan di config/settings.py)
# FORMAT_NOMOR_IZIN={urut:04d}/{kode}/DPMPTSP/{tahun}
# PEJABAT_IZIN=Kepala DPMPTSP Kabupaten Lombok Timur
